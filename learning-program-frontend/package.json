{
  "name": "learning-program-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ssr": "node server.mjs",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "build:ssr": "pnpm run type-check && pnpm run build:ssr:client && pnpm run build:ssr:server",
    "build:ssr:client": "vite build --outDir dist/ssr/client",
    "build:ssr:server": "vite build --ssr src/entry-server.ts --outDir dist/ssr/server",
    "start": "node server.mjs --prod"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "element-plus": "^2.14.6",
    "express": "^5.3.0",
    "markdown-it": "^15.0.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tsconfig/node24": "^24.0.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
