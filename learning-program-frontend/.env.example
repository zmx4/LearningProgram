# 复制为 .env 或 .env.local 后按需修改；.env / .env.local 已被 .gitignore 忽略
# 用法：pnpm dev 或 pnpm build 前设置，改完需重启 dev server

# dev / preview 时 vite 把 /api 转发到的后端地址，默认 http://127.0.0.1:1231
VITE_DEV_API_TARGET=http://127.0.0.1:1231

# 构建产物中前端直连的后端地址。留空表示与前端同源（推荐：由 nginx 等反向代理转发 /api）
# 前后端确实分开部署时才填写，例如 VITE_API_BASE_URL=http://192.168.1.10:1231
VITE_API_BASE_URL=
