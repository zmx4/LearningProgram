# 复制为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，仅本地调试使用
# 用法：source .env && mvn spring-boot:run

# MySQL
export MYSQL_USERNAME=your_mysql_user
export MYSQL_PASSWORD=your_mysql_password
export MYSQL_HOST=127.0.0.1
export MYSQL_PORT=3306

# Redis
export REDIS_HOST=127.0.0.1
export REDIS_PORT=6379
export REDIS_PASSWORD=

# 邮箱验证码发信：只有 learning.mail.delivery=smtp 时才需要这些
# 开发环境保持 delivery=log（默认值），验证码直接输出到服务端日志，不配 SMTP 也能跑通
export MAIL_HOST=
export MAIL_PORT=587
export MAIL_USERNAME=
export MAIL_PASSWORD=
export MAIL_FROM=no-reply@example.com

# RabbitMQ：只有 learning.mail.queue.enabled=true 时才需要
# 没装 broker 时保持默认 false 即可，验证码会同步发送；开了但连不上也会自动回退
export RABBITMQ_HOST=127.0.0.1
export RABBITMQ_PORT=5672
export RABBITMQ_USERNAME=guest
export RABBITMQ_PASSWORD=guest
