  interface AccountMapper
  interface AccountPointsMapper
  interface CheckInRecordMapper
  interface NotificationMapper
  interface CourseMapper
  interface CourseChapterMapper
  interface CourseQuestionSetMapper
  interface CourseProgressMapper
  interface CourseStudyLogMapper
  interface CourseRewardMapper
  interface QuestionSetMapper
  interface QuestionSetItemMapper
  interface TestTypeMapper
  interface TestQuestionMapper
  interface KnowledgeTestRecordMapper
  interface WordTestRecordMapper
