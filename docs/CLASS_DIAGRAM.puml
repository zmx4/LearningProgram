@startuml
title LearningProgram 后端类图（Spring Boot + MyBatis-Plus 分层架构）

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

' ============================ controller 层 ============================
package "controller · REST 接口层" #E8F0FE {

  class AuthorizeController
  class UserController
  class ProfileController
  class NotificationController
  class AccountPointsController
  class CheckInController
  class DictionaryController
  class CetWordController
  class CourseProgressController
  class QuestionSetController
  class TestTypeController
  class TestQuestionController
  class KnowledgeTestController
  class WordTestController
  class ResourceController
  class TestController

  package "管理员接口（/api/admin，admin 角色）" #F5F5F5 {
    class AdminController
    class AdminCourseController
    class AdminQuestionSetController
    class AdminTestBankController
    class AdminResourceController
  }
}

' ============================ service 接口层 ============================
package "service · 业务接口层" #E6F4EA {

  interface AccountService {
    +findAccountByUsernameOrEmail(text): Account
    +registerEmailAccount(vo): String
    +createAccount(username, email, password): String
    +changePassword(accountId, vo): String
    +resetPassword(accountId): String
    +updateProfile(accountId, vo): Account
    +resetConfirm(vo): String
    +restEmailAccountPassword(vo): String
  }
  interface AccountPointsService {
    +getTotalPoints(accountId): int
    +addPoints(accountId, points): void
  }
  interface CheckInService {
    +getStatus(accountId, year, month): Map
    +checkIn(accountId): CheckInRecord
  }
  interface NotificationService {
    +findByAccountId(accountId): List
    +markRead(accountId, id): boolean
    +markAllRead(accountId): boolean
  }
  interface CourseProgressService {
    +getOverview(accountId): CourseProgressOverviewVO
    +getCourseDetail(courseId): CourseDetailVO
    +getCourseProgress(accountId, courseId): CourseStudyProgressVO
    +recordStudy(accountId, courseId, vo): CourseStudyResultVO
  }
  interface CourseService {
    +listCourses(): List
    +getCourse(id): AdminCourseVO
    +createCourse(vo): AdminCourseVO
    +updateCourse(id, vo): AdminCourseVO
    +deleteCourse(id): void
  }
  interface QuestionSetService {
    +listSets(): List
    +getSetDetail(id): QuestionSetDetailVO
    +createSet(vo): QuestionSetVO
    +updateSet(id, vo): QuestionSetVO
    +deleteSet(id): void
  }
  interface TestTypeService {
    +listTypes(): List
    +getType(id): TestType
    +createType(vo): TestType
    +updateType(id, vo): TestType
    +deleteType(id): void
  }
  interface TestQuestionService {
    +getQuestions(typeId, kind, count): List
    +listByIds(ids): List
    +createQuestion(typeId, vo): TestQuestionVO
    +updateQuestion(id, vo): TestQuestionVO
    +deleteQuestion(id): void
  }
  interface KnowledgeTestService {
    +saveResult(accountId, vo): KnowledgeTestRecordVO
    +getSummary(accountId): Map
    +getHistory(accountId): List
  }
  interface WordTestService {
    +saveResult(accountId, record): WordTestRecord
    +getSummary(accountId): Map
    +getHistory(accountId): List
  }
  interface LearningResourceService {
    +listVisible(): List
    +listAll(): List
    +upload(file, title, description, visible, accountId): ResourceVO
    +setVisible(id, visible): void
    +delete(id): void
    +getResource(id): LearningResource
    +resolveStoredPath(storedName): Path
  }
  interface DictionaryService
  interface CetWordService {
    +findRandomCet4(count): List
    +findRandomCet6(count): List
  }
}

