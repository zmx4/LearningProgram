          <mxCell id="02-account-e2" value="签到" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=9;fontColor=#3d4b5c;labelBackgroundColor=#ffffff;startFill=0;endFill=0;strokeColor=#4a6da7;strokeWidth=1.2;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="02-account-db_account" target="02-account-db_check_in"><mxGeometry relative="1" as="geometry" /></mxCell>
