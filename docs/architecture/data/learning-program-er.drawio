          <mxCell id="02-account-evidence" value="证据（当前 DDL）：&lt;br&gt;scripts/learning.sql:8-32（db_account、db_account_points 及 FK/UNIQUE）&lt;br&gt;scripts/learning.sql:48-57（db_check_in，唯一键 account_id + checkin_date）&lt;br&gt;scripts/learning.sql:218-230（db_notification，FK ON DELETE CASCADE）&lt;br&gt;docs/DATABASE.md:86-112（points 旧字段说明）" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="1140" height="90" as="geometry" /></mxCell>
