          <mxCell id="01-register-reset-evidence" value="证据（当前代码）：&lt;br&gt;AuthorizeController.java:42-90（password-policy / register / ask-code / reset-confirm / reset-password）&lt;br&gt;AccountServiceImpl.java:59-144（发送验证码、注册、消费验证码）&lt;br&gt;AccountServiceImpl.java:204-236（找回密码先校验后改密）&lt;br&gt;EmailCodeService.java:48-103（Redis 频控、生成、校验、消费）&lt;br&gt;SecurityConfiguration.java:53-69（/api/auth/** 匿名放行）&lt;br&gt;RegisterPage.vue:160-201 / ForgetPage.vue:156-196（前端两步操作）" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1573" width="1325" height="118" as="geometry" /></mxCell>
        </root>
      </mxGraphModel>
    </diagram>
  <diagram id="02-login-session" name="02 登录、两步验证与会话">
      <mxGraphModel dx="1200" dy="1659" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1659" math="0" shadow="0">
        <root>
          <mxCell id="0" />
          <mxCell id="1" parent="0" />
          <mxCell id="02-login-session-title" value="登录、两步验证与会话：JWT 无状态认证" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1f2d3d;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1120" height="34" as="geometry" /></mxCell>
          <mxCell id="02-login-session-s0" value="登录页：输入用户名 / 密码 / 记住我" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="93" width="170" height="54" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p1" value="提交登录表单&lt;br&gt;POST /api/auth/login (form-urlencoded)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0ff;strokeColor=#4a7ebb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="191" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p2" value="JwtAuthorizeFilter 先执行&lt;br&gt;无 Bearer Token → 放行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="291" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p3" value="Spring Security 认证&lt;br&gt;loadUserByUsername + BCrypt 校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="391" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-d1" value="用户名 / 密码正确？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="478" width="190" height="84" as="geometry" /></mxCell>
          <mxCell id="02-login-session-x1" value="401 认证失败&lt;br&gt;返回统一错误信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="491" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-d2" value="账号已启用 TOTP？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="578" width="190" height="84" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p4" value="返回 428 + challenge&lt;br&gt;Redis 保存 5 分钟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="591" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p5" value="前端弹出两步验证输入框&lt;br&gt;输入 6 位动态码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0ff;strokeColor=#4a7ebb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="691" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p6" value="POST /api/2fa/login&lt;br&gt;校验 challenge + TOTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="791" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-d3" value="challenge 与验证码有效？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="878" width="190" height="84" as="geometry" /></mxCell>
          <mxCell id="02-login-session-x2" value="401 验证码错误&lt;br&gt;或挑战已过期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="605" y="891" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p7" value="writeAuthorization：签发 JWT&lt;br&gt;id / username / authorities / exp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="691" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p8" value="按「记住我」写入&lt;br&gt;localStorage / sessionStorage 的 authorize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0ff;strokeColor=#4a7ebb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="791" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p9" value="跳转 /index&lt;br&gt;路由守卫校验登录态与 adminOnly 角色" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0ff;strokeColor=#4a7ebb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="891" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p10" value="后续请求：Axios 注入 Bearer Token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0ff;strokeColor=#4a7ebb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="991" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p11" value="JwtAuthorizeFilter.resolveJwt&lt;br&gt;验签 + Redis 黑名单 + 过期校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="1091" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-d4" value="Token 有效？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1178" width="190" height="84" as="geometry" /></mxCell>
          <mxCell id="02-login-session-x3" value="受保护接口 401&lt;br&gt;清登录态 → 登录页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="1191" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p12" value="写入 SecurityContext 与 request.id&lt;br&gt;Controller 读取当前用户" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="1291" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-e0" value="访问业务接口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="1393" width="170" height="54" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p13" value="登出：POST /api/auth/logout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0ff;strokeColor=#4a7ebb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="875" y="991" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p14" value="invalidateToken&lt;br&gt;jti 写入 Redis 黑名单至过期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="875" y="1091" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-p15" value="清除 authorize&lt;br&gt;跳转登录页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0ff;strokeColor=#4a7ebb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="875" y="1191" width="220" height="58" as="geometry" /></mxCell>
          <mxCell id="02-login-session-n_guest" value="游客模式&lt;br&gt;/index、GET /api/courses/progress、&lt;br&gt;GET /api/dictionary/** 允许匿名只读" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="845" y="278" width="280" height="84" as="geometry" /></mxCell>
          <mxCell id="02-login-session-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5b6b7c;strokeWidth=1;fontSize=10;fontColor=#3d4b5c;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="02-login-session-s0" target="02-login-session-p1"><mxGeometry relative="1" as="geometry" /></mxCell>
